/* ==========================================================================
   styles.qss - Tema en blancos y azules atenuados (WCAG 2.1: texto AAA, controles 3:1)
   Los valores vienen de palette.py (AccessibleColors); al cambiar uno, cambiar los dos.
   Comprobar contrastes: python app/palette.py
   ========================================================================== */

QWidget {
    background-color: #BFC9DA;              /* BG_WINDOW: azul grisáceo claro, sin deslumbrar */
    color: #111B31;                         /* TEXT_PRIMARY: 10,3:1 */
    font-size: 16px;
    selection-background-color: #1D4C8F;
    selection-color: #FFFFFF;
}

/* ---------- Títulos y textos ---------- */
QLabel#tituloVista {
    font-size: 26px;
    font-weight: 700;
}

QLabel#tituloTarjeta {
    font-size: 18px;
    font-weight: 700;
}

QLabel#instruccion {                        /* calibración: texto grande, se lee también en voz alta */
    font-size: 32px;
    font-weight: 700;
    background-color: transparent;          /* no tapar los blancos de la calibración de pantalla */
}

QLabel#ayudaCalibracion {                   /* notas al pie: para quien acompaña */
    background-color: transparent;
    color: #2B3650;                         /* TEXT_MUTED: 7,2:1 sobre el fondo */
    font-size: 15px;
}

/* ---------- Bloques (todos los botones) ---------- */
QPushButton {
    background-color: #CFD8E6;              /* BG_BLOCK */
    color: #111B31;                         /* 11,9:1 */
    border: 2px solid #4B5B7E;              /* BORDER_DEFAULT: 4,1:1 frente al fondo */
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 22px;                        /* grande: los bloques se leen de lejos */
    font-weight: 600;
}

QPushButton:hover {
    background-color: #C3CEDF;              /* BG_HOVER */
}

QPushButton:pressed {
    background-color: #173F75;              /* SELECTED_PRESSED */
    color: #FFFFFF;
}

QPushButton:disabled {                      /* mientras termina una acción */
    background-color: #C8CFDB;
    color: #56617B;
    border-color: #A3AEC2;
}

QPushButton#volverBtn {                     /* en una esquina, pero grandes: se apuntan con la mirada */
    min-height: 80px;
    min-width: 320px;
    font-size: 19px;
}

/* ---------- Encender / apagar: apoyo de color, nunca el único aviso (el texto y el icono ya lo
   dicen), así que sigue sirviendo igual para daltonismo rojo-verde. Ver main.clasificar_accion. */
QPushButton[accion="on"] {
    background-color: #CFE3D3;              /* BG_ON */
}
QPushButton[accion="on"]:hover {
    background-color: #C3D9CC;              /* BG_ON_HOVER */
}
QPushButton[accion="on"]:focus,
QPushButton[accion="on"]:focus:hover {
    background-color: #1B5E33;              /* ON */
    border-color: #0F3A1F;                  /* ON_BORDER */
}

QPushButton[accion="off"] {
    background-color: #E9CFCF;              /* BG_OFF */
}
QPushButton[accion="off"]:hover {
    background-color: #DDC5C8;              /* BG_OFF_HOVER */
}
QPushButton[accion="off"]:focus,
QPushButton[accion="off"]:focus:hover {
    background-color: #7A1B1B;              /* OFF */
    border-color: #4A0F0F;                  /* OFF_BORDER */
}

/* ---------- Bloque seleccionado (cruceta o mirada): el bloque "se ilumina" ----------
   Pasa de claro a azul oscuro, con texto blanco (8,5:1) y borde el doble de grueso: se nota por
   luminosidad y por grosor, no solo por el tono. Va después de :hover para ganarle. */
QPushButton:focus,
QPushButton:focus:hover {
    background-color: #1D4C8F;              /* SELECTED */
    color: #FFFFFF;
    border: 4px solid #0A2657;              /* SELECTED_BORDER */
    font-weight: 700;
}

/* ---------- Etiqueta de fila (p. ej. "Televisión 1" a la izquierda de sus bloques) ---------- */
QLabel#etiquetaFila {
    background-color: transparent;
    font-size: 20px;
    font-weight: 700;
}

/* ---------- Editor de comandos (para quien acompaña: controles de tamaño normal) ---------- */
QPushButton#botonEditor,
QMessageBox QPushButton {
    font-size: 17px;
    padding: 8px 14px;
    border-radius: 8px;
    min-width: 90px;
}

QLabel#etiquetaCampo {
    background-color: transparent;
    font-size: 17px;
    font-weight: 700;
}

QLabel#errorCampo {                         /* el mensaje siempre dice qué falta: no depende del color */
    background-color: transparent;
    color: #6B0F0F;                         /* TEXT_ERROR: 7,4:1 */
    font-size: 17px;
    font-weight: 700;
}

QLineEdit, QComboBox, QListWidget {
    background-color: #DDE4EF;              /* BG_SURFACE: texto 13,4:1 */
    color: #111B31;
    border: 2px solid #4B5B7E;              /* 4,1:1 frente al fondo */
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 18px;
}

QLineEdit:focus, QComboBox:focus, QListWidget:focus {
    border: 3px solid #0A2657;              /* foco visible y más grueso */
}

QListWidget::item {
    padding: 8px;
}

QListWidget::item:selected,
QComboBox QAbstractItemView {
    selection-background-color: #1D4C8F;
    selection-color: #FFFFFF;
}

QListWidget::item:selected {
    background-color: #1D4C8F;              /* blanco sobre azul: 8,5:1 */
    color: #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #DDE4EF;
    color: #111B31;
}

QToolTip {
    background-color: #111B31;
    color: #FFFFFF;
    border: 1px solid #0A2657;
    font-size: 15px;
}

/* Selector de iconos: el elegido lleva borde grueso (no solo color). Con el foco pasa a fondo oscuro,
   porque el icono se vuelve blanco al tener el foco. */
QPushButton#opcionIcono {
    min-width: 50px; max-width: 50px;
    min-height: 50px; max-height: 50px;
    padding: 4px;
    border-radius: 8px;
}

QPushButton#opcionIcono:checked {
    background-color: #DDE4EF;
    border: 4px solid #0A2657;
}

QPushButton#opcionIcono:checked:focus {
    background-color: #1D4C8F;
}

/* ---------- Barra de progreso de la calibración ---------- */
QProgressBar {
    background-color: #C9D2E1;              /* BG_GUIDE */
    border: 2px solid #4B5B7E;
    border-radius: 6px;
    min-height: 18px;
    max-height: 18px;
}

QProgressBar::chunk {
    background-color: #1D4C8F;              /* 5,6:1 sobre la barra */
    border-radius: 4px;
}

/* ---------- Desplazamiento (solo si algo no cabe) ---------- */
QScrollArea {
    border: none;
}

QScrollBar:vertical {
    background-color: #C9D2E1;
    width: 14px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #4B5B7E;
    min-height: 40px;
    border-radius: 7px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
